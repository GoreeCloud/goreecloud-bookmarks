{
  "schema_version": 1,
  "product": "GoreeCloud Bookmarks",
  "model": "single unified cross-device bookmark tree",
  "clients": ["desktop", "mobile", "tablet", "web"],
  "root": {
    "id": "root",
    "label": "Bookmarks",
    "device_specific": false,
    "platform_specific": false
  },
  "hierarchy": {
    "folders": true,
    "nested_subfolders": true,
    "ordering": true,
    "move_between_folders": true
  },
  "prohibited_roots": ["Mobile Bookmarks", "Bookmarks Toolbar", "Bookmarks Menu", "Other Bookmarks"],
  "sync": {
    "shared_tree_for_all_signed_in_clients": true,
    "preserve_hierarchy": true,
    "preserve_order": true,
    "offline_changes_queue": true,
    "deterministic_conflict_handling_required": true
  },
  "browser_relationship": {
    "signed_out_browser_store": "Local Bookmarks",
    "signed_in_browser_store": "GoreeCloud Bookmarks",
    "automatic_local_upload_on_sign_in": false,
    "explicit_import_or_move_required": true
  },
  "production_approved": false
}
