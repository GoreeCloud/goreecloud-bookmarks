{
  "id": "/dashboard",
  "name": "GoreeCloud Bookmarks",
  "short_name": "GoreeCloud Bookmarks",
  "description": "A private, self-hosted bookmark and read-later workspace.",
  "icons": [
    {
      "src": "/goreecloud-bookmarks.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/api/v1/links/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "url": "link"
    }
  },
  "theme_color": "#0f172a",
  "background_color": "#0f172a",
  "display": "standalone",
  "orientation": "portrait",
  "start_url": "/dashboard"
}
