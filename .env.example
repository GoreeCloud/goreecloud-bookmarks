# GoreeCloud Bookmarks — sanitized development configuration example
#
# Do not place active credentials in this file. Active environment files and
# database URLs are protected infrastructure configuration and must remain
# outside ordinary Git history.

# Optional local-development HTTP listener. The service defaults to
# 127.0.0.1:8080 when this variable is omitted.
GOREECLOUD_BOOKMARKS_LISTEN_ADDR=127.0.0.1:8080

# PostgreSQL connection URL used by the service readiness check and the
# explicit bookmarks-migrate command. Replace every example value in a
# protected local/deployment environment; never commit the resulting secret.
# Production TLS/database policy is deployment-specific and is not established
# by this Experimental repository template.
GOREECLOUD_BOOKMARKS_DATABASE_URL=postgres://bookmarks:replace-me@db.example.invalid:5432/bookmarks?sslmode=verify-full
